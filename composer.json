{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "developer-tools/json-formatter",
    "type": "project",
    "description": "A small, fast JSON formatter, minifier, and validator built with Laravel.",
    "keywords": ["laravel", "json", "formatter", "validator", "developer-tool"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
    "phpunit/phpunit": "^12.0"
    },
    "autoload": {
    "psr-4": {
        "App\\": "app/"
    }
    },
    "autoload-dev": {
    "psr-4": {
        "Tests\\": "tests/"
    }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php vendor/bin/phpunit",
            "npm run test:js"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
